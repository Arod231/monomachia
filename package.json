{
  "name": "monomachia",
  "private": true,
  "version": "0.1.0",
  "description": "A one-on-one weapon duel for Windows, built in Godot: posture, parries, disarms and ultimates.",
  "type": "module",
  "scripts": {
    "test": "npm run test:node && npm run test:godot",
    "test:node": "node --test --test-reporter=spec \"tests/**/*.test.mjs\"",
    "test:godot": "node scripts/godot.mjs test",
    "typecheck": "npm run typecheck:godot",
    "typecheck:godot": "node scripts/godot.mjs typecheck",
    "soak:godot": "node scripts/godot.mjs soak",
    "soak:tune": "node scripts/godot.mjs soak 300",
    "godot": "node scripts/godot.mjs",
    "godot:dev": "node scripts/godot.mjs dev",
    "godot:run": "node scripts/godot.mjs run",
    "shots": "node scripts/godot.mjs shots",
    "audio:sonniss": "node scripts/audio/extract-sonniss.mjs",
    "audio:synth": "node scripts/audio/synth.mjs",
    "audio:music": "node scripts/audio/music.mjs",
    "check:sizes": "node scripts/check-sizes.mjs",
    "release": "node scripts/godot.mjs release",
    "brain": "node tools/second-brain/build.mjs",
    "brain:serve": "node tools/second-brain/serve.mjs",
    "board": "node tools/lanes-board/server.mjs",
    "board:hooks": "node tools/lanes-board/install-hooks.mjs"
  },
  "engines": {
    "node": ">=22.12"
  }
}
